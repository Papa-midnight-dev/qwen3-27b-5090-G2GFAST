# The settings of branch g2gfast-0.8.1 (28 Nov 2026). Use: docker run --env-file this-file ...
# See GUIDE.md and LOCAL-PATCHES.md. Lines starting with # are comments.
WEIGHTS=/models/weights
SERVED_MODEL_NAME=qwen3.8-27b
SPEC=dspine
KV_DTYPE=fp8
VISION=fp8
MAX_TOKENS=131072
MIN_KV_TOKENS=131072
MAX_SEQS=8
# GPU memory the engine may use, in GiB. 25.2 leaves room for a desktop on the same card; on a headless box you can raise it.
VRAM_BUDGET_GIB=25.2
STATE_HOST_CACHE=8
# Upstream settings that differ from upstream's defaults: the one-term output head and an 8,192-token draft window.
Q27_ACT_A4X2=off
Q27_LM_HEAD_A4X2=0
Q27_DRAFT_WINDOW=8192
# kit4b-0.8.1 base: copy steps, edit copy, greedy best-first draft tree, short-prompt attention kernel, token cache.
Q27_COPY=1
Q27_COPY_ROWS=128
Q27_COPY_SAMPLED=1
Q27_EDIT_COPY=1
Q27_SPEC_BFTREE=1
Q27_BFTREE_NODES=16
Q27_BFTREE_TEMP=1.2
Q27_FA_SMALL=1
Q27_TOKEN_CACHE_MB=16
# g2gfast-0.8.1 Class A (bit-identical SM120 silicon kernels: -3.6% to -7.47% step latency).
Q27_ML_L2_HINT=3
Q27_ML_FUSE_RN=3
Q27_ML_GDN_PREP=2
Q27_ML_GDN_CS=1
# g2gfast-0.8.1 Class B (strictly lossless OPT speculative tree C=1 & C=2, 1-slot kSnap1 GDN DFS, self-editcopy).
# Remove the three lines below for pure bit-identical Class A mode.
Q27_ML_OPT_TREE=1
Q27_ML_SELF_EC=1
Q27_ML_BATCH_OPT=4
